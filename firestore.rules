rules_version = '2';

// Regras de acesso do Cadastro de Entregadores.
// - Dono (DONO_EMAIL): lê tudo, aprova/reprova/desfaz, exclui e libera membros.
// - Membros (um documento em membros/{email em minúsculas}): leem e criam cadastros.
// - Qualquer outra pessoa: nenhum acesso.
// Troque o e-mail abaixo pelo mesmo de window.DONO_EMAIL em firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function emailDono() { return "dono@exemplo.com"; }

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() { return request.auth.token.email.lower(); }
    function ehDono() { return logado() && meuEmail() == emailDono(); }
    function ehMembro() {
      return logado() && (ehDono() || exists(/databases/$(database)/documents/membros/$(meuEmail())));
    }

    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() > 0 && d[campo].size() <= max);
    }
    function cadastroValido(d) {
      return d.keys().hasOnly(['idApp', 'cpf', 'cidade', 'observacao', 'criadoEm', 'criadoPor'])
        && d.criadoPor == request.auth.uid
        && d.criadoEm is string && d.criadoEm.size() <= 40
        && d.cidade is string && d.cidade.size() > 0 && d.cidade.size() <= 80
        && ('idApp' in d || 'cpf' in d)
        && textoOpcional(d, 'idApp', 40)
        && textoOpcional(d, 'cpf', 14)
        && textoOpcional(d, 'observacao', 600);
    }
    function decisaoValida(d) {
      return d.keys().hasOnly(['status', 'em', 'por', 'motivo', 'detalhe'])
        && d.status in ['aprovado', 'reprovado']
        && d.em is string && d.por == request.auth.uid
        && (d.status == 'aprovado' || d.motivo is string)
        && textoOpcional(d, 'motivo', 100)
        && textoOpcional(d, 'detalhe', 300);
    }

    match /cadastros/{id} {
      allow read: if ehMembro();
      allow create: if ehMembro() && cadastroValido(request.resource.data);
      allow update: if false;
      allow delete: if ehDono();
    }

    // O id da decisão é o mesmo do cadastro.
    match /decisoes/{id} {
      allow read: if ehMembro();
      allow create, update: if ehDono() && decisaoValida(request.resource.data)
        && exists(/databases/$(database)/documents/cadastros/$(id));
      allow delete: if ehDono();
    }

    // Nome de quem enviou/decidiu, para mostrar no painel e no histórico.
    match /perfis/{uid} {
      allow read: if ehMembro();
      allow write: if ehMembro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email'])
        && request.resource.data.email == meuEmail();
    }

    // Quem pode usar o app. O dono cadastra aqui (ou direto pelo Console do Firebase).
    match /membros/{email} {
      allow read: if ehDono() || (logado() && email == meuEmail());
      allow write: if ehDono();
    }
  }
}
